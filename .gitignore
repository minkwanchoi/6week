# 비밀값 파일: 키와 비밀번호가 든 환경 설정 파일
.env
# 비밀값 파일: .env.local처럼 이름 뒤에 꼬리가 붙은 환경 설정 파일
.env.*

# 개인정보가 든 원자료: raw 폴더 안의 파일은 모두 뺀다
raw/*
# 단, 지어낸 값으로 채운 예시 파일(이름이 _예시.md로 끝남)은 넣는다
!raw/*_예시.md

# 실제 업무 내용이 든 결과물: out 폴더에 새로 생기는 파일은 모두 뺀다
# 지어낸 값으로 만든 예시 결과만 git add -f로 골라 넣는다(이미 넣은 파일은 그대로 남음)
out/*

# 맥에서 폴더를 열면 자동으로 생기는 파일
.DS_Store
# 윈도우에서 그림 미리보기 때문에 자동으로 생기는 파일
Thumbs.db

# 오피스 문서를 열어 둔 동안 생기는 잠금·임시 파일
~$*
# 한글·오피스가 작업 중에 만드는 임시 파일
*.tmp
# 한글이 저장할 때 남기는 백업 파일
*.bak
# 한글이 자동 저장으로 남기는 파일
*.asv
# 문서를 열어 둔 동안 생기는 잠금 파일
.~lock.*#

# 페인포인트 문서의 백업 사본: 원본과 겹치므로 뺀다
01_페인포인트_bak.md

# PDF 파일
*.pdf

# 한글·오피스 문서: 실제 업무 내용이 들어 있을 수 있어 뺀다
*.hwp
*.hwpx
*.doc
*.docx
*.ppt
*.pptx
# 표 파일: 명단 같은 개인정보가 들어 있을 수 있어 뺀다
*.xls
*.xlsx
*.csv

# 그림 파일: 화면 캡처에 이름·주소가 찍힐 수 있어 뺀다
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp

# 비밀값 파일: 인증서와 개인 키
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# 비밀값 파일: 계정 정보와 비밀값을 모아 둔 설정 파일
credentials*.json
secrets*.json

# 5주차 기록에 쓴 화면 캡처: 기록 문서만 넣고 그림은 뺀다
5주차_기록_캡처.png

# 이 컴퓨터에서만 쓰는 개인 설정 파일
.claude/settings.local.json
